<div class="app-shell">
    <header class="app-header">
        <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => OnBack.InvokeAsync())" Title="Back"><Ico Name="back" /></FluentButton>
        <span class="title">Settings</span>
    </header>

    <div class="content-area">
        <div class="settings">
            <h2>Settings</h2>

            <div class="setting-row">
                <div class="setting-label">Appearance</div>
                <FluentRadioGroup TValue="ThemeMode" Value="@CurrentMode" ValueChanged="OnRadioChanged"
                                  Orientation="Orientation.Vertical">
                    <FluentRadio Value="@ThemeMode.System">Use system theme</FluentRadio>
                    <FluentRadio Value="@ThemeMode.Light">Light</FluentRadio>
                    <FluentRadio Value="@ThemeMode.Dark">Dark</FluentRadio>
                </FluentRadioGroup>
            </div>

            <div class="setting-row">
                <div class="setting-label">Global history</div>
                @if (!_confirming)
                {
                    <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@(_count == 0)"
                                  OnClick="@(() => _confirming = true)">Clear global history</FluentButton>
                    <span class="muted" style="margin-left:.6rem">
                        @(_cleared ? "History cleared." : $"{_count} item{(_count == 1 ? "" : "s")}")
                    </span>
                }
                else
                {
                    <span>Clear all @_count entries?</span>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ClearHistory" style="margin-left:.6rem">Clear</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => _confirming = false)">Cancel</FluentButton>
                }
            </div>

            <div class="setting-row">
                <div class="setting-label">Guided tour</div>
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="RestartTour">Show the tour again</FluentButton>
                <span class="muted" style="margin-left:.6rem">A few tooltips pointing at the main features. You can skip it at any step, or put it off until next time.</span>
            </div>

            <div class="setting-row muted">
                MarkdownBlaze@(MarkdownService.AppVersion is { } version ? " " + version : "") — offline Markdown viewer · Photino + Fluent UI
            </div>
        </div>
    </div>
</div>

@inject HistoryStore History
@inject PreferencesStore Prefs

@code {
    [Parameter] public ThemeMode CurrentMode { get; set; }
    [Parameter] public EventCallback<ThemeMode> OnModeChanged { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private int _count;
    private bool _confirming;
    private bool _cleared;

    protected override void OnInitialized() => _count = History.Entries.Count;

    private async Task OnRadioChanged(ThemeMode mode)
    {
        CurrentMode = mode;
        await OnModeChanged.InvokeAsync(mode);
    }

    // The tour belongs to the viewer; going back there with it marked unseen is what starts it.
    private async Task RestartTour()
    {
        Prefs.Current.TourSeen = false;
        Prefs.Current.TourDeferrals = 0;
        Prefs.Current.TourOfferedThisRun = false;
        Prefs.Save();
        await OnBack.InvokeAsync();
    }

    private void ClearHistory()
    {
        History.Clear();
        _count = 0;
        _confirming = false;
        _cleared = true;
    }
}
