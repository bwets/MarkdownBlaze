@implements IDisposable
@inject NavigationService Nav
@inject MarkdownService Markdown
@inject FileTreeService Tree
@inject PreferencesStore Prefs
@inject WindowHost Window
@inject WindowStateService WindowState
@inject IJSRuntime JS

<div class="app-shell">
    <header class="app-header @(_pinned ? "" : "no-sidebar")">
        @* Three toolbars. Left: what you do with files — it sits over the sidebar and is as wide as
           it. Middle: the sidebar toggle, the way back and forth, and the title — it starts exactly
           where the document does and moves with the splitter. Right: how the document is shown. *@
        <span class="toolbar-left">
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenFile" Title="Open file (Ctrl+O)"><Ico Name="open" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="PickFolder" Title="Open folder (Ctrl+Shift+O)"><Ico Name="tree" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => Nav.Reload())" Title="Refresh (F5)"><Ico Name="refresh" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenPrintBar" Title="Print (Ctrl+P)"><Ico Name="print" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenFolder" Title="Open containing folder"><Ico Name="folder" /></FluentButton>
        </span>

        <span class="toolbar-middle">
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="ToggleSidebar" Title="Toggle sidebar (Ctrl+B)"><Ico Name="menu" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => Nav.Back())" Disabled="@(!Nav.CanBack)" Title="Back (Alt+Left)"><Ico Name="back" /></FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => Nav.Forward())" Disabled="@(!Nav.CanForward)" Title="Forward (Alt+Right)"><Ico Name="forward" /></FluentButton>

            <span class="title">@Nav.CurrentTitle</span>
        </span>

        <span class="toolbar-right">
            <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenViewMenu" Title="@ViewMenuTitle"><Ico Name="view" /></FluentButton>
            <span class="zoom-group">
                <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => ZoomBy(1 / ZoomStep))"
                              Disabled="@(_zoom <= MinZoom + 0.001)" Title="Zoom out (Ctrl+-)"><Ico Name="minus" Size="14" /></FluentButton>
                <span class="zoom-label" title="Document zoom">@ZoomText</span>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="@(() => ZoomBy(ZoomStep))"
                              Disabled="@(_zoom >= MaxZoom - 0.001)" Title="Zoom in (Ctrl++)"><Ico Name="plus" Size="14" /></FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="ResetZoom"
                              Disabled="@(Math.Abs(_zoom - 1) < 0.005)" Title="Reset zoom (Ctrl+0)"><Ico Name="undo" Size="14" /></FluentButton>
        </span>

        <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenThemeMenu" Title="@ThemeMenuTitle"><Ico Name="theme" /></FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" OnClick="OpenMoreMenu" Title="More"><Ico Name="more" /></FluentButton>
        </span>
    </header>

    <div class="app-body @(_pinned ? "" : "no-sidebar") @(_printBarOpen ? "printing" : "")">
        <aside class="sidebar">
            @* Fluent's tabs are used for the strip only. What each tab shows is rendered below by this
               component, as before, so the tabs themselves are left empty. *@
            <div class="tabstrip">
                <FluentTabs ActiveTabId="@TabIds[_tab]" ActiveTabIdChanged="OnTabChanged">
                    <FluentTab Id="@TabIds[0]" Header="Contents" />
                    <FluentTab Id="@TabIds[1]" Header="History" />
                </FluentTabs>
            </div>
            <div class="tab-panels">
                @if (_tab == 0)
                {
                    @* The folder the reader is working in. Folders and documents are panels, so the two
                       cannot be mistaken for what is inside them; the open document's panel holds its
                       headings as a tree. One list covers both moving between files and within one. *@
                    <div class="list tree" id="md-tree">
                        @if (_detached is not null) { @RenderPanels([_detached]) }
                        @if (Tree.Root is not null)
                        {
                            @RenderPanels(_nodes)
                        }
                        else
                        {
                            <div class="empty">Open a file or a folder to see its documents here.</div>
                        }
                    </div>
                }
                else
                {
                    <div class="list">
                        @if (Nav.GlobalHistory.Count == 0) { <div class="empty">No history.</div> }
                        @foreach (var e in Nav.GlobalHistory)
                        {
                            <div class="row-wrap">
                                <button class="row" title="@e.Path"
                                        @onclick="@(() => Nav.Navigate(e.Path))"
                                        @oncontextmenu="@(ev => OpenRowMenu(ev, e.Path))" @oncontextmenu:preventDefault="true">
                                    @e.Title
                                </button>
                                <button class="row-del" title="Remove from history"
                                        @onclick="@(() => RemoveHistory(e.Path))">×</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </aside>

        <div id="md-splitter" class="splitter"></div>

        @* document-pane marks this as the pane holding the document, so a content theme can paper it
           without also papering the Settings page, which uses the same .content-area layout class. *@
        <main class="content-area document-pane">
            @* @key forces Blazor to discard and rebuild this subtree on every navigation instead of
               diffing it. The rendered markdown is mutated in place by highlight.js / mermaid / KaTeX,
               so diffing against Blazor's virtual DOM would corrupt the render tree.

               lang is the document's own language, which is what the text is hyphenated by. *@
            <div class="content markdown-body" lang="@Nav.CurrentLanguage" @key="Nav.RenderToken">@((MarkupString)Nav.CurrentHtml)</div>
        </main>
    </div>
</div>

@if (_toast is not null)
{
    @* Cycling with the keyboard gives no other feedback: without this you press F9 and have to work
       out from the page what you landed on. Sits above the print bar when that is open.

       @key is what makes a second press show anything: without it Blazor reuses the element and only
       swaps the text, so the fade animation never restarts and the toast stays at the invisible end
       of its last run. A new key each time means a new element, and a new element starts fresh. *@
    <div class="toast" @key="_toastToken" style="@($"bottom:{(_printBarOpen ? 76 : _rateBarOpen ? 62 : 28)}px")">@_toast</div>
}

@if (_rateBarOpen && !_printBarOpen)
{
    @* Asked once and quietly. Either button is an answer, and so is the ×: none of them leads to
       being asked again. Gives way to the print bar, which wants the same strip of the window. *@
    <div class="rate-bar" role="status">
        <span>Enjoying MarkdownBlaze? A rating in the Microsoft Store helps other people find it.</span>
        <button class="rate-bar-go" @onclick="RateApp">Rate it</button>
        <button class="rate-bar-close" title="No thanks — don't ask again" @onclick="DismissRating">×</button>
    </div>
}

@if (_printBarOpen)
{
    <div class="print-bar" role="toolbar" aria-label="Print">
        <span class="print-bar-label">Print theme</span>
        @foreach (var theme in ContentThemes.All)
        {
            <button class="print-chip @(theme.Id == _printTheme ? "active" : "")"
                    @onclick="@(() => PreviewPrintTheme(theme.Id))">@theme.Label</button>
        }
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="DoPrint">Print</FluentButton>
        <span class="print-bar-hint">Ctrl+P to print · Esc to cancel</span>
    </div>
}

@if (_menuOpen)
{
    <div class="menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="ctx" style="@MenuStyle">
        @foreach (var item in _menuItems)
        {
            <button @onclick="@(() => RunItem(item.OnClick))">@item.Label</button>
        }
    </div>
}

@if (_whatsNewHtml is not null)
{
    @* app-look sits on the dialog, not on the page inside it: it restates the app's own look for
       everything beneath, so the page reads the same whichever document theme is on. *@
    <div class="menu-backdrop" @onclick="CloseWhatsNew" @oncontextmenu="CloseWhatsNew" @oncontextmenu:preventDefault="true"></div>
    <div class="whats-new app-look" role="dialog" aria-label="What's new">
        <div class="whats-new-head">
            <span>What's new</span>
            <button class="whats-new-close" title="Close (Esc)" @onclick="CloseWhatsNew">×</button>
        </div>
        <div class="whats-new-body markdown-body">@((MarkupString)_whatsNewHtml)</div>
    </div>
}

@if (_shortcutsOpen)
{
    <div class="menu-backdrop" @onclick="CloseShortcuts" @oncontextmenu="CloseShortcuts" @oncontextmenu:preventDefault="true"></div>
    <div class="shortcuts" role="dialog" aria-label="Keyboard shortcuts">
        <div class="shortcuts-head">Keyboard shortcuts</div>
        <table class="shortcuts-table">
            @foreach (var s in Shortcuts)
            {
                <tr>
                    <td class="sc-action">@s.Action</td>
                    <td class="sc-keys">
                        @{ var firstAlt = true; }
                        @foreach (var alt in s.Keys.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                        {
                            @if (!firstAlt) { <span class="sc-or">/</span> }
                            firstAlt = false;
                            var keys = alt.Split('+');
                            @for (var i = 0; i < keys.Length; i++)
                            {
                                @if (i > 0) { <span class="sc-plus">+</span> }
                                <kbd>@keys[i]</kbd>
                            }
                        }
                    </td>
                </tr>
            }
        </table>
        <div class="shortcuts-foot">Press <kbd>?</kbd> or <kbd>Esc</kbd> to close</div>
    </div>
}

@code {
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    private bool _pinned = true;
    private bool _shortcutsOpen;
    private string? _whatsNewHtml; // the rendered "what's new" page while its popup is open
    private bool _printBarOpen;
    private bool _rateBarOpen;
    private string _printTheme = ContentThemes.Auto;
    private int _tab;

    // (action, keys) shown in the ? shortcuts overlay. Keys are space-separated tokens; "+" joins a chord.
    private static readonly (string Action, string Keys)[] Shortcuts =
    [
        ("Toggle sidebar", "F1 Ctrl+B"),
        ("Back / Forward", "Alt+← Alt+→"),
        ("Refresh", "F5 Ctrl+R"),
        ("Open file", "Ctrl+O"),
        ("Open folder", "Ctrl+Shift+O"),
        ("Next / previous view", "F2 Shift+F2"),
        ("Next / previous document theme", "F9 Shift+F9"),
        ("Zoom the document", "Ctrl+Wheel Ctrl++ Ctrl+-"),
        ("Reset zoom", "Ctrl+0"),
        ("Print (pick a theme, then Ctrl+P again)", "Ctrl+P"),
        ("Fullscreen", "F11"),
        ("Show this help", "?"),
        ("Close popup / leave fullscreen", "Esc"),
    ];
    private int _lastRenderToken = -1;
    private string? _lastPath;
    private IReadOnlyList<TreeNode> _nodes = [];
    private TreeNode? _detached; // the open document, when it is not inside the tree's folder

    /// <summary>Element id of the open document's panel, so it can be scrolled into view.</summary>
    private const string CurrentPanelId = "md-current-doc";

    /// <summary>
    /// Folders and documents as nested panels. A folder's panel holds the panels of what is inside
    /// it; the panel of the document being read holds its outline.
    /// </summary>
    private RenderFragment RenderPanels(IReadOnlyList<TreeNode> nodes) => __builder =>
    {
        foreach (var node in nodes)
        {
            if (node.Kind == TreeNodeKind.Folder)
            {
                <section class="panel panel-folder @(node.Expanded ? "open" : "")" @key="node.Path">
                    <button class="panel-head" title="@node.Path" aria-expanded="@(node.Expanded ? "true" : "false")"
                            @onclick="@(() => Tree.Toggle(node.Path))">
                        <span class="panel-icon"><Ico Name="@(node.Expanded ? "tree" : "folder")" Size="15" /></span>
                        <span class="panel-label">@node.Label</span>
                        <span class="panel-chevron"><Ico Name="chevron" Size="12" /></span>
                    </button>
                    @if (node.Expanded)
                    {
                        <div class="panel-body">
                            @if (node.Children.Count == 0) { <div class="panel-empty">No documents</div> }
                            @RenderPanels(node.Children)
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="panel panel-file @(node.Current ? "current" : "") @(node.Expanded ? "open" : "")" @key="node.Path">
                    <button class="panel-head" id="@(node.Current ? CurrentPanelId : null)" title="@node.Path"
                            aria-expanded="@(node.Current ? (node.Expanded ? "true" : "false") : null)"
                            @onclick="@(() => OnFilePanel(node))"
                            @oncontextmenu="@(e => OpenRowMenu(e, node.Path))" @oncontextmenu:preventDefault="true">
                        <span class="panel-icon"><Ico Name="file" Size="15" /></span>
                        <span class="panel-label">@node.Label</span>
                        @if (node.Current) { <span class="panel-chevron"><Ico Name="chevron" Size="12" /></span> }
                    </button>
                    @if (node.Expanded)
                    {
                        <div class="panel-body outline">
                            @if (Nav.CurrentHeadings.Count == 0) { <div class="panel-empty">No headings</div> }
                            @foreach (var heading in Nav.CurrentHeadings)
                            {
                                @* data-slug is how app.js finds the row for the section being read. *@
                                <button class="outline-row" style="@($"--level:{heading.Level - _topHeadingLevel}")" data-slug="@heading.Slug"
                                        title="@heading.Text" @onclick="@(() => ScrollTo(heading.Slug))">@heading.Text</button>
                            }
                        </div>
                    }
                </section>
            }
        }
    };

    // The outline is indented from its shallowest heading, so a document that starts at ## does not
    // waste a level of the sidebar's width.
    private int _topHeadingLevel = 1;

    /// <summary>A document's panel opens the document; on the one already open it folds the outline.</summary>
    private void OnFilePanel(TreeNode node)
    {
        if (node.Current) Tree.ToggleOutline(node.Path);
        else Nav.Navigate(node.Path);
    }

    // Unified popup menu (More button + row context menu).
    private bool _menuOpen;
    private bool _menuRight;
    private double _menuX, _menuY;
    private List<(string Label, Action OnClick)> _menuItems = [];

    private string MenuStyle => _menuRight
        ? "top:46px; right:8px"
        : $"left:{_menuX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; top:{_menuY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";

    protected override void OnInitialized()
    {
        _pinned = Prefs.Current.SidebarPinned;
        _tab = Math.Clamp(Prefs.Current.SidebarTab, 0, 1);
        _viewMode = ViewModes.ResolveMode(Prefs.Current.ViewMode);
        _pageFit = ViewModes.ResolveFit(Prefs.Current.PageFit);
        _contentTheme = ContentThemes.Resolve(Prefs.Current.ContentTheme).Id;
        _zoom = Math.Clamp(Prefs.Current.DocumentZoom, MinZoom, MaxZoom);

        Nav.Changed += OnNavChanged;
        Tree.Changed += OnTreeChanged;
        JsBridge.Key += OnKey;
        JsBridge.SidebarResized += OnSidebarResized;
        JsBridge.DocumentZoomed += OnDocumentZoomed;
        JsBridge.TourEnded += OnTourEnded;
        JsBridge.TourPrintBar += OnTourPrintBar;

        Nav.Initialize();

        // Whatever the app was pointed at is the folder the reader is working in — unless that is the
        // bundled manual, which lives in the install directory and is nobody's working folder. Only
        // when no folder has been set yet: the viewer is created again on the way back from Settings,
        // and that must not move the tree to the folder of whatever document is open by then.
        if (Tree.Root is null && Nav.CurrentPath is not null && !MarkdownService.IsUserManual(Nav.CurrentPath))
            Tree.SetRootFromFile(Nav.CurrentPath);

        RefreshRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // No remembered width → null, and app.js picks the default against the left toolbar.
            await JS.InvokeVoidAsync("mdSetSidebarWidth", (int?)Prefs.Current.SidebarWidth);
            await JS.InvokeVoidAsync("mdInitResizer", "md-splitter");
            // Theme first (it decides the paper colour), then zoom, then the view mode: pagination
            // reads both of the others.
            await ApplyContentTheme(_contentTheme);
            await JS.InvokeVoidAsync("mdSetDocumentZoom", Prefs.Current.DocumentZoom, false);
            await JS.InvokeVoidAsync("mdSetViewMode", _viewMode, _pageFit);
            // Offered on first run — and again whenever Settings asks for it, which brings the reader
            // back to a freshly created viewer and so back through here. Once per run of the app: put
            // off with Later, it waits for the next launch.
            if (!Prefs.Current.TourSeen && !Prefs.Current.TourOfferedThisRun)
            {
                Prefs.Current.TourOfferedThisRun = true;
                await JS.InvokeVoidAsync("mdStartTour", Prefs.Current.TourDeferrals < Preferences.MaxTourDeferrals);
            }
        }
        if (Nav.RenderToken != _lastRenderToken)
        {
            // Reset the scroll position only when the document actually changed (link click, back/
            // forward, history) — not on a same-file reload/auto-refresh, which keeps your place.
            var documentChanged = Nav.CurrentPath != _lastPath;
            _lastRenderToken = Nav.RenderToken;
            _lastPath = Nav.CurrentPath;
            await JS.InvokeVoidAsync("mdInit");
            // The title is what the print dialog calls the job and what "Save as PDF" offers as the
            // filename; the fragment puts the document into the window's address, which is what the
            // browser prints in the page footer.
            await JS.InvokeVoidAsync("mdSetDocumentTitle", Nav.CurrentTitle,
                                     UriScheme.FragmentForFile(Nav.CurrentPath));
            if (documentChanged)
            {
                CountDocumentForRating();
                await JS.InvokeVoidAsync("mdScrollTop");
                // Put the open document at the top of the tree: after following a link it is often
                // far down a long folder, and a highlighted panel you cannot see is no help.
                await JS.InvokeVoidAsync("mdScrollTreeTo", "md-tree", CurrentPanelId);
            }
        }
    }

    private void OnNavChanged() { RefreshRows(); InvokeAsync(StateHasChanged); }
    private void OnTreeChanged() { RefreshRows(); InvokeAsync(StateHasChanged); }
    private void RefreshRows()
    {
        _nodes = Tree.Nodes(Nav.CurrentPath);
        _detached = Tree.Detached(Nav.CurrentPath);
        _topHeadingLevel = Nav.CurrentHeadings.Count == 0 ? 1 : Nav.CurrentHeadings.Min(h => h.Level);
    }

    private static readonly string[] TabIds = ["tab-contents", "tab-history"];

    private void OnTabChanged(string? id) => SelectTab(Math.Max(0, Array.IndexOf(TabIds, id)));

    private void SelectTab(int index)
    {
        _tab = Math.Clamp(index, 0, 1);
        Prefs.Current.SidebarTab = _tab;
        Prefs.Save();
    }

    private void ToggleSidebar()
    {
        _pinned = !_pinned;
        Prefs.Current.SidebarPinned = _pinned;
        Prefs.Save();
    }

    private async Task ScrollTo(string id)
    {
        if (!string.IsNullOrEmpty(id)) await JS.InvokeVoidAsync("mdScrollTo", id);
    }

    // ---- Printing -------------------------------------------------------------------------------
    // Ctrl+P does not print straight away: it opens the print bar so the content theme for this one
    // print can be picked (previewed live in the document), and a second Ctrl+P sends it.

    private void OpenPrintBar()
    {
        _printTheme = Prefs.Current.ContentTheme;
        _printBarOpen = true;
    }

    private Task PrintShortcut()
    {
        if (_printBarOpen) return DoPrint();
        OpenPrintBar();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Applies a theme to the document while the bar is open, as a preview of the printout.</summary>
    private async Task PreviewPrintTheme(string id)
    {
        _printTheme = id;
        await ApplyContentTheme(id);
    }

    private async Task DoPrint()
    {
        var theme = ContentThemes.Resolve(_printTheme);
        _printBarOpen = false;
        await InvokeAsync(StateHasChanged); // the bar must be gone before the dialog opens
        await JS.InvokeVoidAsync("mdPrint", theme.Id, theme.IsDark);
        await ApplyContentTheme(Prefs.Current.ContentTheme); // the override lasted for this print only
    }

    private async Task CancelPrintBar()
    {
        _printBarOpen = false;
        await ApplyContentTheme(Prefs.Current.ContentTheme);
    }

    private async Task ApplyContentTheme(string id)
    {
        var theme = ContentThemes.Resolve(id);
        await JS.InvokeVoidAsync("mdSetContentTheme", theme.Id, theme.IsDark);
    }

    // Opening something is what sets the folder the tree shows: the file's own folder, or the folder
    // itself. Following a link or a history entry deliberately leaves the root where it is.
    private async Task OpenFile()
    {
        var startDir = Tree.Root ?? (Nav.CurrentPath is not null ? Path.GetDirectoryName(Nav.CurrentPath) : null);
        var path = await Window.PickFileAsync(startDir);
        if (path is null) return;

        Nav.Navigate(path);
        Tree.SetRootFromFile(path);
    }

    private async Task PickFolder()
    {
        var folder = await Window.PickFolderAsync(Tree.Root);
        if (folder is null) return;

        Tree.SetRoot(folder);
        // A folder is opened by opening the document it leads with — its index/main/readme, or the
        // first document in alphabetical order.
        var entry = MarkdownService.FindEntryFile(folder);
        if (entry is not null) Nav.Navigate(entry);
    }

    private void OpenFolder()
    {
        if (Nav.CurrentPath is not null) NavigationService.OpenContainingFolder(Nav.CurrentPath);
    }

    // ---- Zoom -------------------------------------------------------------------------------------
    // The toolbar's −/+/reset act on the same zoom the wheel and Ctrl+/- drive, and the label follows
    // whichever of them was used. The limits and the step match app.js so the buttons grey out exactly
    // when a further step would do nothing.
    private const double ZoomStep = 1.1, MinZoom = 0.4, MaxZoom = 4;

    private double _zoom = 1;

    private string ZoomText => Math.Round(_zoom * 100) + "%";

    private async Task ZoomBy(double factor) => await JS.InvokeVoidAsync("mdZoomBy", factor);
    private async Task ResetZoom() => await JS.InvokeVoidAsync("mdSetDocumentZoom", 1.0, true);

    // ---- Document theme -------------------------------------------------------------------------
    // Next to the More button, because it is a reading choice people change often — far more often
    // than anything else in Settings, which is where it used to live.

    private string _contentTheme = ContentThemes.Auto;

    private string ThemeMenuTitle => "Document theme: " + ContentThemes.Resolve(_contentTheme).Label;

    private void OpenThemeMenu()
    {
        // Anchored to the right edge, like the More menu beside it: this button sits at the end of
        // the toolbar, so a menu opened at the pointer would hang off the side of the window.
        _menuRight = true;
        _menuItems = ContentThemes.All
            .Select(theme => (Tick(theme.Id == _contentTheme) + theme.Label,
                              (Action)(() => _ = SetContentTheme(theme.Id))))
            .ToList();
        _menuOpen = true;
    }

    private async Task SetContentTheme(string id)
    {
        _contentTheme = ContentThemes.Resolve(id).Id;
        Prefs.Current.ContentTheme = _contentTheme;
        Prefs.Save();
        await ApplyContentTheme(_contentTheme);
    }

    /// <summary>Steps to the next or previous theme in the list, wrapping at either end (F9).</summary>
    private async Task CycleContentTheme(int step)
    {
        var themes = ContentThemes.All;
        var index = themes.ToList().FindIndex(t => t.Id == _contentTheme);
        var next = ((index < 0 ? 0 : index) + step + themes.Count) % themes.Count;
        await SetContentTheme(themes[next].Id);
        await ShowToast(themes[next].Label);
    }

    // ---- Toast ------------------------------------------------------------------------------------

    private string? _toast;
    private int _toastToken;

    /// <summary>Names what you just switched to, briefly. A newer message replaces an older one.</summary>
    private async Task ShowToast(string message)
    {
        var token = ++_toastToken;
        _toast = message;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1400);
        if (token != _toastToken) return; // something newer is on screen

        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    // ---- View mode ------------------------------------------------------------------------------
    // Continuous is one endless column; page lays the document onto sheets the way it will print,
    // sized either to the width of the pane or to show a whole sheet at once.

    private string _viewMode = ViewModes.Continuous;
    private string _pageFit = ViewModes.FitWidth;

    private string ViewMenuTitle => _viewMode == ViewModes.Page
        ? $"View: pages, {(_pageFit == ViewModes.FitPage ? "whole page" : "full width")}"
        : "View: continuous";

    // Anchored under the button that opened it rather than to the right edge like the More menu:
    // the zoom control and two more buttons sit between this one and the edge of the window.
    private void OpenViewMenu(MouseEventArgs e)
    {
        _menuRight = false;
        _menuX = Math.Max(8, e.ClientX - 24);
        _menuY = 46;
        _menuItems =
        [
            (Tick(_viewMode == ViewModes.Continuous) + "Continuous", () => _ = SetView(ViewModes.Continuous, _pageFit)),
            (Tick(_viewMode == ViewModes.Page && _pageFit == ViewModes.FitWidth) + "Pages — full width",
                () => _ = SetView(ViewModes.Page, ViewModes.FitWidth)),
            (Tick(_viewMode == ViewModes.Page && _pageFit == ViewModes.FitPage) + "Pages — whole page",
                () => _ = SetView(ViewModes.Page, ViewModes.FitPage)),
        ];
        _menuOpen = true;
    }

    private static string Tick(bool on) => on ? "● " : "○ ";

    /// <summary>
    /// The three ways of looking at a document, in the order F2 steps through them: reading, then
    /// the two paper views.
    /// </summary>
    private static readonly (string Mode, string Fit)[] ViewCycle =
    [
        (ViewModes.Continuous, ViewModes.FitWidth),
        (ViewModes.Page, ViewModes.FitWidth),
        (ViewModes.Page, ViewModes.FitPage),
    ];

    private async Task CycleView(int step)
    {
        var index = Array.FindIndex(ViewCycle, v => v.Mode == _viewMode &&
                                                    (v.Mode == ViewModes.Continuous || v.Fit == _pageFit));
        var next = ((index < 0 ? 0 : index) + step + ViewCycle.Length) % ViewCycle.Length;
        await SetView(ViewCycle[next].Mode, ViewCycle[next].Fit);
        await ShowToast(ViewLabel(ViewCycle[next].Mode, ViewCycle[next].Fit));
    }

    private static string ViewLabel(string mode, string fit) => mode == ViewModes.Page
        ? (fit == ViewModes.FitPage ? "Pages — whole page" : "Pages — full width")
        : "Continuous";

    private async Task SetView(string mode, string fit)
    {
        _viewMode = ViewModes.ResolveMode(mode);
        _pageFit = ViewModes.ResolveFit(fit);
        Prefs.Current.ViewMode = _viewMode;
        Prefs.Current.PageFit = _pageFit;
        Prefs.Save();
        await JS.InvokeVoidAsync("mdSetViewMode", _viewMode, _pageFit);
    }

    private void OpenMoreMenu()
    {
        _menuRight = true;
        _menuItems =
        [
            ("Keyboard shortcuts", () => _shortcutsOpen = true),
            ("What's new", OpenWhatsNew),
            ("Settings", () => _ = OnOpenSettings.InvokeAsync()),
        ];
        _menuOpen = true;
    }

    private void OpenRowMenu(MouseEventArgs e, string path)
    {
        _menuRight = false;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuItems =
        [
            ("Open", () => Nav.Navigate(path)),
            ("Open in new window", () => NavigationService.OpenInNewWindow(path)),
            ("Copy filename", () => CopyName(path)),
            ("Open containing folder", () => NavigationService.OpenContainingFolder(path)),
        ];
        _menuOpen = true;
    }

    private void OpenWhatsNew() => _whatsNewHtml = Markdown.RenderWhatsNew() ?? "<p><em>Nothing to show.</em></p>";
    private void CloseWhatsNew() => _whatsNewHtml = null;

    // ---- Rating request ------------------------------------------------------------------------
    // Documents are counted until the request is due, and not at all once it has been answered.
    // The bundled manual does not count: reading it is not yet using the app.

    private void CountDocumentForRating()
    {
        if (!RatingPrompt.IsPending(Prefs.Current)) return;
        if (Nav.CurrentPath is null || MarkdownService.IsUserManual(Nav.CurrentPath)) return;

        Prefs.Current.DocumentsOpened++;
        Prefs.Save();
        if (!_rateBarOpen && RatingPrompt.IsDue(Prefs.Current))
        {
            _rateBarOpen = true;
            StateHasChanged();
        }
    }

    private void RateApp()
    {
        AnswerRating();
        RatingPrompt.OpenStore();
    }

    private void DismissRating() => AnswerRating();

    /// <summary>Rated or waved away, the request has been answered and is not made again.</summary>
    private void AnswerRating()
    {
        _rateBarOpen = false;
        Prefs.Current.RatingAnswered = RatingPrompt.Campaign;
        Prefs.Save();
    }

    // Finished or skipped, the tour has had its turn; only Settings brings it back. Put off, it is
    // offered again at the next launch.
    private void OnTourEnded(bool deferred)
    {
        if (deferred) Prefs.Current.TourDeferrals++;
        else Prefs.Current.TourSeen = true;
        Prefs.Save();
    }

    // The tour shows the print bar for the length of one step, then puts everything back the way
    // Esc would: bar closed, the document in its own theme again.
    private void OnTourPrintBar(bool open) => InvokeAsync(async () =>
    {
        if (open) OpenPrintBar();
        else if (_printBarOpen) await CancelPrintBar();
        StateHasChanged();
    });

    private void CloseMenu() => _menuOpen = false;
    private void CloseShortcuts() => _shortcutsOpen = false;

    // Delete a single global-history entry (the hover × on a row). The store raises Changed, which
    // refreshes the list.
    private void RemoveHistory(string path) => Nav.RemoveFromHistory(path);
    private void RunItem(Action action) { _menuOpen = false; action(); }

    private void CopyName(string path) => _ = JS.InvokeVoidAsync("mdCopy", Path.GetFileName(path));

    private void OnKey(string combo)
    {
        switch (combo)
        {
            case "alt+left": Nav.Back(); break;
            case "alt+right": Nav.Forward(); break;
            case "f5": case "ctrl+r": Nav.Reload(); break;
            case "ctrl+p": _ = PrintShortcut(); break;
            case "ctrl+o": _ = OpenFile(); break;
            case "ctrl+shift+o": _ = PickFolder(); break;
            case "f1": case "ctrl+b": ToggleSidebar(); InvokeAsync(StateHasChanged); break;
            case "f2": _ = CycleView(1); break;
            case "shift+f2": _ = CycleView(-1); break;
            case "f9": _ = CycleContentTheme(1); break;
            case "shift+f9": _ = CycleContentTheme(-1); break;
            case "f11": WindowState.ToggleFullScreen(); break;
            case "help": _shortcutsOpen = !_shortcutsOpen; InvokeAsync(StateHasChanged); break;
            case "escape":
                if (_shortcutsOpen || _menuOpen || _whatsNewHtml is not null)
                {
                    _shortcutsOpen = false; _menuOpen = false; _whatsNewHtml = null;
                    InvokeAsync(StateHasChanged);
                }
                else if (_printBarOpen) { _ = CancelPrintBar(); InvokeAsync(StateHasChanged); }
                else WindowState.ExitFullScreen(); // nothing open → Esc leaves fullscreen, as everywhere else
                break;
        }
    }

    private void OnDocumentZoomed(double zoom)
    {
        _zoom = zoom;
        Prefs.Current.DocumentZoom = zoom;
        Prefs.Save();
        InvokeAsync(StateHasChanged); // the toolbar shows the percentage, however it was changed
    }

    private void OnSidebarResized(int width)
    {
        Prefs.Current.SidebarWidth = width;
        Prefs.Save();
    }

    public void Dispose()
    {
        Nav.Changed -= OnNavChanged;
        Tree.Changed -= OnTreeChanged;
        JsBridge.Key -= OnKey;
        JsBridge.SidebarResized -= OnSidebarResized;
        JsBridge.DocumentZoomed -= OnDocumentZoomed;
        JsBridge.TourEnded -= OnTourEnded;
        JsBridge.TourPrintBar -= OnTourPrintBar;
    }
}
