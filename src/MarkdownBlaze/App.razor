@inject PreferencesStore Prefs
@inject IJSRuntime JS
@inject IThemeService Theme

@if (_view == AppView.Settings)
{
    <SettingsView CurrentMode="_mode" OnModeChanged="SetMode" OnBack="@(() => Show(AppView.Viewer))" />
}
else
{
    <ViewerView OnOpenSettings="@(() => Show(AppView.Settings))" />
}

<FluentProviders />

@code {
    private enum AppView { Viewer, Settings }

    private AppView _view = AppView.Viewer;
    private ThemeMode _mode = ThemeMode.System;

    protected override void OnInitialized()
    {
        _mode = Prefs.Current.ThemeMode switch
        {
            "Light" => ThemeMode.Light,
            "Dark" => ThemeMode.Dark,
            _ => ThemeMode.System,
        };
    }

    // The document's own theme belongs to the viewer, which owns the toolbar it is chosen from.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ApplyMode();
    }

    // Two things follow the appearance: Fluent's own components, through its theme service, and the
    // app's stylesheets, through the theme class app.js keeps on <html>.
    private async Task ApplyMode()
    {
        await Theme.SetThemeAsync(_mode);
        await JS.InvokeVoidAsync("mdSetTheme", _mode.ToString());
    }

    private void Show(AppView view) => _view = view;

    private async Task SetMode(ThemeMode mode)
    {
        _mode = mode;
        Prefs.Current.ThemeMode = mode.ToString();
        Prefs.Save();
        await ApplyMode();
    }

}
