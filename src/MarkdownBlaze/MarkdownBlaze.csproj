<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem, so launching never opens a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarkdownBlaze</RootNamespace>
    <!-- Embedded exe icon → Explorer, Start-menu/pinned shortcuts, file associations. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Opt out of the solution's central package management + warnings-as-errors. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Faster startup: precompile to native (ReadyToRun) when publishing for a specific runtime,
         and enable tiered PGO so hot paths optimize sooner. R2R needs a RID, so it only kicks in for
         the published `-r <rid>` release build, not plain `dotnet build`. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhotinoX.Blazor" Version="4.2.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.3" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!--
    bwets.Markdig.Extensions: the published NuGet package by default. Set LocalSources=true (e.g. in
    MarkdownBlaze.csproj.user, or -p:LocalSources=true) to reference the sibling source checkout
    instead, so both projects can be edited in one loop. The Configuration guard forces the package
    in Release regardless of LocalSources — a local project reference must never ship in a release.

    The condition lives on the ItemGroups (not a derived property) on purpose: the .user file is
    auto-imported after the project body, but item conditions are evaluated after all properties, so
    they see the final LocalSources value whichever way it was set.
  -->
  <ItemGroup Condition="'$(LocalSources)' == 'true' and '$(Configuration)' != 'Release'">
    <ProjectReference Include="..\..\..\bwets.Markdig.Extensions\src\bwets.Markdig.Extensions\bwets.Markdig.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!('$(LocalSources)' == 'true' and '$(Configuration)' != 'Release')">
    <PackageReference Include="bwets.Markdig.Extensions" Version="0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UserManual.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped so the runtime can set the window icon (Windows loads the .ico via WM_SETICON; Linux uses the .png). -->
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
