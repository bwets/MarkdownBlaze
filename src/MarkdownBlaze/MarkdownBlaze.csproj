<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem, so launching never opens a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarkdownBlaze</RootNamespace>
    <!-- The [LibraryImport] source generator (WindowIcon) emits unsafe marshalling stubs; no hand-written unsafe code exists. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Embedded exe icon → Explorer, Start-menu/pinned shortcuts, file associations. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Faster startup: precompile to native (ReadyToRun) when publishing for a specific runtime,
         and enable tiered PGO so hot paths optimize sooner. R2R needs a RID, so it only kicks in for
         the published `-r <rid>` release build, not plain `dotnet build`. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>

    <!-- What a build made on a developer's machine calls itself. The release workflow passes
         -p:Version=<the real one>, and a property given on the command line wins over this line. The
         app treats any version that ends in -dev as "no version" (MarkdownService.VersionOf): there is
         no number to show for a build nobody released. -->
    <Version>0.0.0-dev</Version>

    <!-- GenerateDocumentationFile (Directory.Build.props) exists for the analyzers; the XML it makes is
         of no use to anyone who runs the app, so it is not published. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!-- Versions live in Directory.Packages.props (central package management). -->
  <ItemGroup>
    <PackageReference Include="PhotinoX.Blazor" />
  </ItemGroup>

  <!-- The components, services, security layer and the page's CSS and JavaScript (served as
       _content/MarkdownBlaze.Core/...) are in the class library; this project is the desktop window. -->
  <ItemGroup>
    <ProjectReference Include="..\MarkdownBlaze.Core\MarkdownBlaze.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests exercise the host's own helpers (the shell launcher, the Windows registration). -->
    <InternalsVisibleTo Include="MarkdownBlaze.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manual and the change log live in MarkdownBlaze.Core/Content/ in the source tree but are copied
         flat into the output root (Link), which is where MarkdownService looks for them and where the
         installer finds them. -->
    <Content Include="..\MarkdownBlaze.Core\Content\UserManual.md" Link="UserManual.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\MarkdownBlaze.Core\Content\WhatsNew.md" Link="WhatsNew.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The notices for the libraries and fonts that ship inside the app (their licences require it). -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped so the runtime can set the window icon (Windows loads the .ico via WM_SETICON; Linux uses the .png). -->
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The class library's documentation XML (made for the analyzers, like this project's own, which
       PublishDocumentationFile above keeps out) travels with its assembly as a "related file"; it is
       of no use to anyone who runs the app. -->
  <Target Name="LeaveCoreDocumentationOutOfThePublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'MarkdownBlaze.Core.xml'" />
    </ItemGroup>
  </Target>

</Project>
