<Project>

  <!--
    Central package management (BUILD-1): every version lives here, project files carry none.
    Dependabot (.github/dependabot.yml) bumps the numbers in this file.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Application -->
  <ItemGroup>
    <PackageVersion Include="PhotinoX.Blazor" Version="5.4.1" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="HtmlSanitizer" Version="11.0.16" />
    <!-- Referenced as a package by default and as a sibling project when LocalSources=true (see the app csproj). -->
    <PackageVersion Include="bwets.Markdig.Extensions" Version="0.1.4" />
  </ItemGroup>

  <!-- Android host (src/MarkdownBlaze.Android). The MAUI packages are held at the version of the installed
       maui-android workload (10.0.110): the workload supplies the platform packs, and a package newer than
       them is not built against what the app runs on. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- Renders the app's Razor components in a test (the shortcuts overlay against the command registry). -->
    <PackageVersion Include="bunit" Version="2.14.0" />
  </ItemGroup>

  <!-- Analyzers, installed into every project of the repository (tests included). Severities: .editorconfig -->
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.321" />
  </ItemGroup>

</Project>
