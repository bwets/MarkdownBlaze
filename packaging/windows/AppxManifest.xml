<?xml version="1.0" encoding="utf-8"?>
<!-- Packaged full-trust (Win32) manifest for MarkdownBlaze. __VERSION__ is substituted by the
     release workflow with a 4-part version (e.g. 1.0.5.0). Publisher must match the signing cert. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 desktop rescap">

  <!-- Identity from Partner Center (Product identity). The package family name derives from these.
       RatingPrompt.StoreReviewUri (src/MarkdownBlaze/Services/RatingPrompt.cs) repeats it as
       <Name>_<hash of the Publisher>; PackagingTests checks that the two agree. -->
  <Identity Name="28961GregoryKieffer.MarkdownBlaze"
            Publisher="CN=87D75823-3F39-43DE-B07A-CCE71CEE43E2"
            Version="__VERSION__"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MarkdownBlaze</DisplayName>
    <!-- Must exactly match the Partner Center account's publisher display name for Store submission. -->
    <PublisherDisplayName>Gregory Kieffer</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MarkdownBlaze" Executable="MarkdownBlaze.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="MarkdownBlaze"
          Description="A fast, offline Markdown viewer."
          BackgroundColor="#2D2D2D"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png">
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.mdx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- markdown:// links: the address the window shows, and what other programs use to hand it a
             document. A packaged app cannot register this at run time (its writes to
             HKCU\Software\Classes go to the package's private hive), so the manifest declares it.
             Activation passes the link to the app as its command-line argument, as the unpackaged
             registration does. The installer's folder verb has no equivalent here: a packaged context
             menu entry (desktop4:FileExplorerContextMenus) needs a COM handler, not a command line,
             so the Store build offers files and links only.
             Verified only by inspection: that activation delivers the link as the argument has not been
             tried on an installed package, so check it on the first install. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="markdown">
            <uap:DisplayName>Markdown document</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Global alias: makes `MarkdownBlaze` runnable from any terminal (the alias is placed in
             %LOCALAPPDATA%\Microsoft\WindowsApps, which is on PATH by default). -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="MarkdownBlaze.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="MarkdownBlaze.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
