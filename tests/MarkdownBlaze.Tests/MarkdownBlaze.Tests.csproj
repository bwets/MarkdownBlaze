<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Versions live in Directory.Packages.props (central package management). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Lets the Windows-only registry tests report "skipped" instead of passing vacuously elsewhere. -->
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Payload and "must survive" fixtures shared by the sanitizer tests. -->
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdownBlaze\MarkdownBlaze.csproj" />
  </ItemGroup>

</Project>
